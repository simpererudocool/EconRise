# LOCAL: npm run dev works with SQLite and no credentials.
# Opt in to separate human-controlled tabs at /?manual=1 (disabled on Vercel).
ECONRISE_MANUAL_TEST=1
# For a local production build only: ECONRISE_LOCAL=1 npm start
# Never set ECONRISE_LOCAL on Vercel.

# VERCEL: all four below are required for production realtime multiplayer.
# Copy Supabase Connect > Transaction pooler URI. URL-encode the password.
# Remove sslmode query options; the pg driver enforces verified TLS itself.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres
# APP_ORIGIN=https://your-stable-project.vercel.app
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-publishable-or-anon-key

# Optional local database path:
# SQLITE_PATH=.data/econrise.sqlite
